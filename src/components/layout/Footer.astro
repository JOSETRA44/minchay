---
import { site } from '../../lib/site';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <a class="wordmark" href="/" aria-label="Minchay, inicio">minchay<span aria-hidden="true">.</span></a>
      <p>Comida casera por suscripción.</p>
    </div>
    <nav aria-label="Pie de página">
      <ul role="list">
        {site.navigation.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        <li><a href={site.waitlist}>Lista de espera</a></li>
      </ul>
    </nav>
  </div>
</footer>
