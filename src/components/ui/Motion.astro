---
// Sistema de movimiento de Minchay, tomado del lenguaje de designcanada.com:
// intro con formas geométricas que se ensamblan, barrido de franjas verticales
// sobre las fotos, revelado por máscara al hacer scroll, parallax leve y un
// fundido ligado a la posición de scroll en la sección del nombre.
// Sin JS, el contenido se ve completo y quieto. Por decisión de la marca,
// las animaciones se reproducen igual en todos los equipos.
---
<div class="intro" aria-hidden="true">
  <div class="intro-mark">
    <span class="intro-shape intro-circle"></span>
    <span class="intro-shape intro-semi"></span>
    <span class="intro-shape intro-bar"></span>
  </div>
  <p class="intro-word">minchay<span>.</span></p>
</div>

<script>
  const root = document.documentElement;

  // Intro: se retira sola; la CSS también la oculta a los 1,6 s por seguridad.
  const intro = document.querySelector('.intro');
  if (intro) {
    const done = () => { intro.remove(); root.classList.remove('has-intro'); };
    if (!root.classList.contains('has-intro')) intro.remove();
    else setTimeout(done, 1450);
  }
  setTimeout(() => root.classList.remove('has-hero-entry'), 2200);

  {
    // Barrido de franjas sobre las fotos al entrar en pantalla.
    const photos = document.querySelectorAll('.photo');
    if ('IntersectionObserver' in window) {
      const photoObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          photoObserver.unobserve(entry.target);
        }
      }, { threshold: 0.25 });
      photos.forEach((photo) => photoObserver.observe(photo));
    } else {
      photos.forEach((photo) => photo.classList.add('in'));
    }

    // Conserva la foto anterior hasta que la entrante termina de revelarse.
    const carousel = document.querySelector('[data-carousel]');
    if (carousel) {
      const slides = [...carousel.querySelectorAll<HTMLImageElement>('[data-carousel-slide]')];
      const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
      const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]');
      const toggle = carousel.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
      let current = 0;
      let paused = false;
      let changing = false;
      let hovering = false;

      const show = async (index: number) => {
        if (changing || index === current) return;
        changing = true;
        const next = slides[index];
        next.loading = 'eager';
        try {
          await next.decode();
          next.classList.add('entering');
          await new Promise<void>((resolve) => {
            requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
          });
          await Promise.allSettled(next.getAnimations().map((animation) => animation.finished));
          slides[current].classList.remove('active');
          slides[current].setAttribute('aria-hidden', 'true');
          dots[current]?.removeAttribute('aria-current');
          next.classList.replace('entering', 'active');
          next.removeAttribute('aria-hidden');
          dots[index]?.setAttribute('aria-current', 'true');
          current = index;
        } catch {
          // Una imagen que no carga deja la anterior a la vista.
        } finally {
          changing = false;
        }
      };

      if (slides.length > 1 && controls) {
        controls.hidden = false;
        dots.forEach((dot, index) => dot.addEventListener('click', () => { void show(index); }));
        toggle?.addEventListener('click', () => {
          paused = !paused;
          toggle.setAttribute('aria-label', paused ? 'Reanudar cambio automático de fotos' : 'Pausar cambio automático de fotos');
          const icon = toggle.querySelector('span');
          if (icon) icon.textContent = paused ? '▶' : 'Ⅱ';
        });
        carousel.querySelector('.hero-photo')?.addEventListener('mouseenter', () => { hovering = true; });
        carousel.querySelector('.hero-photo')?.addEventListener('mouseleave', () => { hovering = false; });
        setInterval(() => {
          if (paused || hovering || document.hidden || carousel.matches(':focus-within')) return;
          const { top, bottom } = carousel.getBoundingClientRect();
          if (bottom <= 0 || top >= innerHeight) return;
          void show((current + 1) % slides.length);
        }, 5200);
      }
    }

    // Scroll: cabecera con sombra, manifiesto frase a frase ligado al
    // scroll y parallax leve en las fotos marcadas. Un solo handler con rAF.
    const header = document.querySelector('.site-header');
    const manifiesto = document.querySelector('[data-manifiesto]');
    const frases = manifiesto ? [...manifiesto.querySelectorAll('[data-frase]')] : [];
    const puntos = manifiesto ? [...manifiesto.querySelectorAll('[data-punto]')] : [];
    manifiesto?.classList.add('activo');
    const parallaxImages = [...document.querySelectorAll('img[data-parallax]')];
    const story = document.querySelector<HTMLElement>('[data-day-story]');
    const cinematicLayout = matchMedia('(min-width: 54rem) and (min-height: 34rem)');
    const meals = Array.from(story?.querySelectorAll('[data-day-meal]') ?? []);
    const frames = Array.from(story?.querySelectorAll<HTMLImageElement>('[data-day-frame]') ?? []).slice(1);
    const meter = story?.querySelector<HTMLElement>('[data-day-meter]');
    const clamp = (value: number) => Math.min(1, Math.max(0, value));

    function updateDayStory() {
      if (!story || !cinematicLayout.matches || !meals.length) return;
      const bounds = story.getBoundingClientRect();
      if (bounds.bottom < 0 || bounds.top > innerHeight) return;

      const center = innerHeight * .49;
      const positions = meals.map((meal) => {
        const { top, height } = meal.getBoundingClientRect();
        return top + height / 2;
      });
      const distance = positions[positions.length - 1] - positions[0];
      const progress = distance > 0 ? clamp((center - positions[0]) / distance) : 0;
      meter?.style.setProperty('transform', `scaleX(${progress})`);

      frames.forEach((frame, index) => {
        const midpoint = (positions[index] + positions[index + 1]) / 2;
        const blend = clamp(.5 + (center - midpoint) / (innerHeight * .32));
        frame.style.opacity = String(blend);
        frame.style.transform = `scale(${1 + (1 - blend) * .065})`;
      });
    }

    let ticking = false;
    const update = () => {
      ticking = false;
      header?.classList.toggle('scrolled', window.scrollY > 12);
      if (manifiesto && frases.length) {
        const rect = manifiesto.getBoundingClientRect();
        const travel = rect.height - innerHeight;
        const progress = travel > 0 ? clamp(-rect.top / travel) : 1;
        const position = progress * frases.length;
        const actual = Math.min(frases.length - 1, Math.floor(position));
        manifiesto.classList.toggle('en-pantalla', rect.top < innerHeight && rect.bottom > 0);
        manifiesto.style.setProperty('--avance', String(progress));
        frases.forEach((frase, i) => {
          frase.classList.toggle('on', i === actual);
          frase.classList.toggle('past', i < actual);
        });
        puntos.forEach((punto, i) => {
          (punto as HTMLElement).style.setProperty('--avance-frase', String(clamp(position - i)));
        });
      }
      for (const img of parallaxImages) {
        const box = img.parentElement?.getBoundingClientRect();
        if (!box || box.bottom < 0 || box.top > window.innerHeight) continue;
        const offset = (box.top + box.height / 2 - window.innerHeight / 2) * -0.045;
        img.style.transform = `translateY(${offset.toFixed(1)}px) scale(1.14)`;
      }
      updateDayStory();
    };
    const queueUpdate = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };
    addEventListener('scroll', queueUpdate, { passive: true });
    addEventListener('resize', queueUpdate);
    if (story) {
      const syncLayout = () => {
        story.toggleAttribute('data-cinematic', cinematicLayout.matches);
        queueUpdate();
      };
      cinematicLayout.addEventListener('change', syncLayout);
      syncLayout();
    }
    update();
  }
</script>
