---
interface Props {
  photo: { src: string; alt: string; width: number; height: number };
  eager?: boolean;
}
const { photo, eager = false } = Astro.props;
---
<div class="photo">
  <img {...photo} data-editorial-photo loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
</div>
