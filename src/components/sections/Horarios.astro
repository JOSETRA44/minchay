---
import { horarios } from '../../domain/horarios';
---
<section class="schedule" aria-labelledby="horarios-title">
  <div class="wrap schedule-inner">
    <div>
      <h2 id="horarios-title">Tu día, a tu hora.</h2>
      <p>Horarios de ejemplo, programables.</p>
    </div>
    <ul role="list">
      {horarios.map(({ comida, hora, datetime }) => <li><time datetime={datetime}>{hora}</time><span>{comida}</span></li>)}
    </ul>
  </div>
</section>
