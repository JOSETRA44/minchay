---
import { heroSlides } from '../../domain/fotos';
import { site, ruta } from '../../lib/site';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="dot"></span> En fase de lanzamiento</p>
    <h1 id="hero-title">La comida de toda tu semana, <em>resuelta hoy.</em></h1>
    <p class="lead">{site.subtitle}</p>
    <div class="actions">
      <a class="button" href={site.waitlist}>{site.cta} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={ruta('/como-funciona/')}>Ver cómo funciona <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero-reel" data-carousel>
    <div class="photo hero-photo" id="hero-photos">
      {heroSlides.map(({ src, alt, width, height }, i) => (
        <img src={src} alt={alt} width={width} height={height} class={i === 0 ? 'slide active' : 'slide'} data-carousel-slide aria-hidden={i === 0 ? undefined : 'true'} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
      ))}
      <span class="wipe" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <i style={`--d:${(i * 0.06).toFixed(2)}s`}></i>)}</span>
    </div>
    <a class="scroll-hint" href="#horarios"><i aria-hidden="true"></i>Desliza</a>
    <div class="carousel-dots" data-carousel-controls hidden>
      {heroSlides.map((_, i) => (
        <button type="button" class="dot-seg" aria-controls="hero-photos" aria-current={i === 0 ? 'true' : undefined} aria-label={`Ver foto ${i + 1}`} data-carousel-dot><span></span></button>
      ))}
      <button class="carousel-toggle" type="button" aria-label="Pausar cambio automático de fotos" data-carousel-toggle><span aria-hidden="true">Ⅱ</span></button>
    </div>
  </div>
</section>
