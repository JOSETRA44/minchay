<section class="section origin manifiesto" data-manifiesto aria-labelledby="nombre-title">
  <h2 id="nombre-title" class="sr-only">La idea de Minchay, frase a frase.</h2>
  <div class="manifiesto-track">
    <div class="manifiesto-pin">
      <div class="wrap manifiesto-escena">
        <div class="manifiesto-texto">
          <span class:list={['frase', { acento: false }]} data-frase><svg class="frase-icono" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="vapor" style="--vd:0s" d="M17 13c-1.6-2.2 1.6-3.6 0-5.8"/><path class="vapor" style="--vd:.5s" d="M24 12c-1.6-2.2 1.6-3.6 0-5.8"/><path class="vapor" style="--vd:1s" d="M31 13c-1.6-2.2 1.6-3.6 0-5.8"/><path d="M8 35a16 16 0 0 1 32 0"/><path d="M4 39h40"/><circle cx="24" cy="17" r="1.8"/></svg><span class="frase-texto">¿Otra vez pensando qué comer?</span></span>
          <span class:list={['frase', { acento: true }]} data-frase><svg class="frase-icono" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle class="trazo-circulo" cx="24" cy="24" r="17"/><path class="trazo-check" d="M15 24.5l6.5 6.5L33 19"/></svg><span class="frase-texto">Minchay lo resuelve por ti.</span></span>
          <span class:list={['frase', { acento: false }]} data-frase><svg class="frase-icono" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="17"/><path d="M24 24V14.5"/><path class="aguja" d="M24 24l7.5 4.5"/></svg><span class="frase-texto">Cocinamos. Repartimos. Llega a tu hora.</span></span>
          <span class:list={['frase', { acento: false }]} data-frase><svg class="frase-icono" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 33a13 13 0 0 1 26 0"/><path class="rayo" d="M24 11V6.5"/><path class="rayo" style="--vd:.4s" d="M13.5 17L10 13.5"/><path class="rayo" style="--vd:.8s" d="M34.5 17L38 13.5"/><path d="M5 39h38"/></svg><span class="frase-texto">Mincha, en quechua, es pasado mañana.</span></span>
          <span class:list={['frase', { acento: true }]} data-frase><svg class="frase-icono" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="chispa" d="M24 5l3.4 15.6L43 24l-15.6 3.4L24 43l-3.4-15.6L5 24l15.6-3.4z"/></svg><span class="frase-texto">Tú, a lo tuyo.</span></span>
        </div>
        <div class="manifiesto-puntos" aria-hidden="true">
          <span class="punto" data-punto></span><span class="punto" data-punto></span><span class="punto" data-punto></span><span class="punto" data-punto></span><span class="punto" data-punto></span>
        </div>
      </div>
    </div>
  </div>
</section>
